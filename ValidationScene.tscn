[gd_scene load_steps=3 format=3 uid="uid://bm8kdhwu5eosc"]

[ext_resource type="Script" uid="uid://by8vrlbl41cmi" path="res://scripts/PersistenceValidator.gd" id="1_0hdqx"]

[sub_resource type="GDScript" id="GDScript_1"]
script/source = "extends Control

@onready var validator = $PersistenceValidator
@onready var status_label = $UI/StatusLabel
@onready var instructions = $UI/Instructions

func _ready():
	validator.validation_completed.connect(_on_validation_completed)

func _on_validation_completed(success: bool, report: String):
	if success:
		status_label.text = \"✅ Status: Validação APROVADA - Sistema funcionando corretamente!\"
		status_label.modulate = Color.GREEN
		instructions.append_text(\"\\n\\n[color=green][b]🎉 SUCESSO![/b][/color]\\nO sistema de persistência está funcionando. Não haverá mais criação de novos jogadores a cada inicialização.\")
	else:
		status_label.text = \"❌ Status: Validação FALHOU - Problemas detectados\"
		status_label.modulate = Color.RED
		instructions.append_text(\"\\n\\n[color=red][b]⚠️ PROBLEMAS DETECTADOS![/b][/color]\\nVerifique o console para detalhes dos problemas encontrados.\")

func _on_clear_console():
	print(\"\\n\" * 50)
	print(\"Console limpo - Execute nova validação se necessário\")
"

