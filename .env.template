# Template de variáveis de ambiente para Firebase - APENAS CLIENT-SIDE
# Copie este arquivo para .env e preencha com suas credenciais reais
# NUNCA commite o arquivo .env no Git!

# ========================================
# CONFIGURAÇÕES ESSENCIAIS DO FIREBASE
# ========================================
# Obtenha essas informações em:
# Firebase Console > Configurações do Projeto > Geral > Seus apps > Configuração

FIREBASE_API_KEY=your_api_key_here
FIREBASE_AUTH_DOMAIN=your_project_id.firebaseapp.com
FIREBASE_DATABASE_URL=https://your_project_id-default-rtdb.firebaseio.com/
FIREBASE_PROJECT_ID=your_project_id
FIREBASE_STORAGE_BUCKET=your_project_id.appspot.com
FIREBASE_MESSAGING_SENDER_ID=your_sender_id
FIREBASE_APP_ID=your_app_id

# ========================================
# CONFIGURAÇÕES OPCIONAIS
# ========================================

# Analytics (opcional)
FIREBASE_MEASUREMENT_ID=your_measurement_id

# OAuth Providers (opcional - apenas se usar login social)
FIREBASE_FACEBOOK_ID=your_facebook_app_id
FIREBASE_GOOGLE_ID=your_google_client_id
FIREBASE_TWITTER_ID=your_twitter_api_key
FIREBASE_GITHUB_ID=your_github_client_id

# ========================================
# NOTA IMPORTANTE SOBRE SERVICE ACCOUNTS
# ========================================
# Para jogos mobile, você NÃO precisa de service account!
# Service accounts são apenas para:
# - Aplicações server-side
# - Admin SDK
# - Operações privilegiadas no backend
#
# Seu jogo mobile funciona perfeitamente com:
# - Client-side authentication (email/password, anônimo, OAuth)
# - Realtime Database com regras de segurança
# - Cloud Storage com regras de segurança
# - Todas as funcionalidades normais do Firebase