[sub_resource type="GDScript" id="GDScript_1"]
script/source = "extends Control

# Script para CredentialsValidationScene.tscn
# Executa validação completa das credenciais Firebase

@onready var validator = preload(\"res://firebase_credentials_validator.gd\").new()

func _ready():
	# Adiciona o validador como filho
	add_child(validator)
	
	# Conecta o sinal de conclusão
	validator.validation_completed.connect(_on_validation_completed)
	
	print(\"🔍 Iniciando validação completa das credenciais Firebase...\")

func _on_validation_completed(success: bool, report: Dictionary):
	print(\"\\n✨ Validação de credenciais concluída!\")
	
	if success:
		print(\"🎉 Todas as credenciais estão válidas e prontas para uso!\")
		print(\"✅ Sistema aprovado para produção.\")
	else:
		print(\"⚠️ Problemas encontrados nas credenciais Firebase.\")
		print(\"📖 Consulte o relatório acima para detalhes e correções necessárias.\")
	
	# Aguarda um pouco antes de sair (para poder ler os logs)
	await get_tree().create_timer(3.0).timeout
	
	# Sai do jogo
	get_tree().quit()
"

